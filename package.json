{
  "name": "@n8codes/apexlink",
  "version": "5.0.0",
  "description": "Thin Node invoker for @apex-dev-tools/apex-ls, delivered as a JAR",
  "author": "n8codes",
  "homepage": "https://github.com/MayTheSForceBeWithYou/apexlink#readme",
  "license": "MIT",
  "main": "lib/index",
  "types": "lib/index",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "jars",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@flxbl-io/sfp-logger": "^5.0.1",
    "@n8codes/sfdx-process-wrapper": "^4.0.0",
    "find-java-home": "^2.0.0",
    "fs-extra": "^11.3.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MayTheSForceBeWithYou/apexlink.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('./lib',{recursive:true,force:true}); fs.rmSync('./tsconfig.tsbuildinfo',{force:true});\"",
    "compile": "tsc -b tsconfig.json",
    "clearCache": "jest --clearCache",
    "test": "jest --silent --verbose --coverage --detectOpenHandles",
    "spec-test": "jest -i tests/ApexDependencyCheckImpl.test.ts --verbose --coverage --detectOpenHandles",
    "prepublishOnly": "npm run build"
  },
  "bugs": {
    "url": "https://github.com/MayTheSForceBeWithYou/apexlink/issues"
  }
}
